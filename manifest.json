{
  "manifest_version": 3,
  "name": "Scroll Capture",
  "version": "0.2.0",
  "description": "自动识别右侧滚动区域并截取完整内容",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "offscreen",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "截取滚动区域 (Option+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "capture-scroll": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "捕获右侧滚动区域完整内容"
    }
  }
}
